# alpha-jerry 配置样板
# 复制为 .env 并填入真实值；.env 不入库

# ===== LLM =====
# 交互式 CLI 可将密钥保存到 macOS Keychain / Windows Credential Locker；
# 环境变量或 .env 中的密钥优先于系统钥匙串。
LLM_PROVIDER=deepseek

# 提示：report 交互选择会自动记忆到 data/cache/llm_preferences.json，
# 该偏好优先于下面的模型配置；此处配置仅作为首次运行的兜底。

# DeepSeek
DEEPSEEK_API_KEY=
# 可选：deepseek-flash / deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 智谱 GLM
GLM_API_KEY=
# 可选：glm-5.3 / glm-5.3-flash / glm-5.2 / glm-5-turbo / glm-5.1 / glm-5
GLM_MODEL=glm-5.3-flash
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# ===== 锐评子系统 =====
# 主 Provider 校验失败后切换到的 Provider：auto=另一家；填与主 Provider 相同则不切换
REVIEW_FALLBACK_PROVIDER=auto
# 主 Provider 重试次数（带违规反馈）；全部失败后走规则模板兜底
REVIEW_MAX_RETRIES=1
# 三段 JSON 输出预算与温度（思考链已关闭，预算只覆盖正文）
REVIEW_MAX_TOKENS=600
REVIEW_TEMPERATURE=0.3
# 本地缓存 data/cache/review/：同一事实 + 同一提示词版本 + 同一模型不重复调用
REVIEW_CACHE_ENABLED=true

# ===== 数据源（Tushare）=====
# 从 https://tushare.pro 注册后获取 token，填入下方
# vip 接口（income_vip/balancesheet_vip/cashflow_vip/fina_indicator_vip/forecast_vip/express_vip/fina_mainbz_vip）需 5000 积分
# 积分获取：https://tushare.pro/document/1?doc_id=13 ；积分频次对应表：https://tushare.pro/document/1?doc_id=290
TUSHARE_TOKEN=

# ===== 数据与采集 =====
DATA_DIR=data
CONCURRENCY=4
# 5000积分=500次/分钟（常规数据无上限）；2000积分=200次/分钟（10万次/天）
TUSHARE_RATE_LIMIT=500
# "最新"缓存有效期（小时），过期重采以获取新报告期；0 表示永不过期
CACHE_TTL_HOURS=24
# 批量采集参数
BATCH_SIZE=500       # 流式写盘每批次行数（中低配 100~500）
VIP_PAGE_SIZE=5000   # VIP 分页每页行数（默认 5000）
PERF_MODE=mid        # low(低配)/mid(中配)/high(高配)

# ===== 微信 iLink Bot =====
# 直连腾讯官方个人微信 Bot API，不经过 OpenClaw
WECHAT_BASE_URL=https://ilinkai.weixin.qq.com
WECHAT_CHANNEL_VERSION=2.4.8
WECHAT_BOT_AGENT=alpha-jerry/1.0.0
WECHAT_POLL_TIMEOUT_MS=35000
# 空=仅允许扫码授权者；多个 ilink_user_id 用逗号分隔
WECHAT_ALLOWED_USERS=
WECHAT_DIGEST_TIMES=09:00,17:00
WECHAT_MAX_MESSAGE_CHARS=1800
# 境内域名，避免被 all_proxy 劫持
WECHAT_TRUST_ENV=false
